---
const features = [
  {
    icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
    title: "Client-Side Privacy",
    description: "Your data never leaves your browser. All parsing and conversion are executed locally on your device with zero server transmission."
  },
  {
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    title: "Real-Time Instant Conversion",
    description: "Converts as you type or paste. Instant syntax validation with precise line and column error reporting for effortless debugging."
  },
  {
    icon: "M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z",
    title: "One-Click Export & Copy",
    description: "Copy your formatted JSON or YAML directly to clipboard or download it as a .json or .yaml file with a single click."
  },
  {
    icon: "M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4",
    title: "Custom Formatting & Minification",
    description: "Control output indentation (2 spaces, 4 spaces, or Tabs), compress JSON for production APIs, or sort keys alphabetically."
  }
];
---

<section id="features" class="py-16 bg-canvas border-b border-hairline transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 text-center max-w-2xl mx-auto">
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-mute block mb-2">
        BUILT FOR DEVELOPERS & DEVOPS
      </span>
      <h2 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-ink mb-3">
        Why Choose yamltojson.net?
      </h2>
      <p class="text-base text-body">
        Designed for speed, data privacy, and clean developer workflows when working with Kubernetes manifests, CI/CD pipelines, and web APIs.
      </p>
    </div>

    <!-- Feature Cards Grid (4-up grid, Hairline cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((item) => (
        <div class="bg-canvas-elevated p-6 rounded-xl border border-hairline shadow-2xs hover:border-mute transition duration-200 flex flex-col justify-between group">
          <div>
            <div class="w-10 h-10 rounded-[6px] bg-canvas border border-hairline text-ink flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon} />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-ink mb-2 tracking-tight">
              {item.title}
            </h3>
            <p class="text-xs text-body leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
