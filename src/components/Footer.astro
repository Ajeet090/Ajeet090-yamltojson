        <ul class="space-y-2 text-body font-medium">
          <li><a href="/about/" class="hover:text-link transition">About Us</a></li>
          <li><a href="/privacy/" class="hover:text-link transition">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-link transition">Terms & Conditions</a></li>
          <li><a href="/contact/" class="hover:text-link transition">Contact Us</a></li>
        </ul>
      </div>

