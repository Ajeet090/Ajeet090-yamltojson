    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 pb-8 border-b border-hairline">
      
      <!-- Column 1: Brand & Description -->
      <div class="md:col-span-2 space-y-3">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-6 h-6 rounded-[6px] bg-ink text-canvas flex items-center justify-center font-mono font-bold text-xs">
            YJ
          </div>
          <span class="font-semibold text-ink text-sm tracking-tight">yamltojson.net</span>
        </a>
        <p class="text-xs text-body max-w-sm leading-relaxed">
