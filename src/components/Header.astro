---
<header class="w-full bg-[#fafafa]/90 border-b border-[#ebebeb] sticky top-0 z-50 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="YAML to JSON Home">
      <div class="w-7 h-7 rounded-[6px] bg-[#171717] text-white flex items-center justify-center font-mono font-bold text-xs shadow-xs transition-transform group-hover:scale-105">
        YJ
      </div>
      <span class="font-semibold text-base text-[#171717] tracking-tight">
        YAML to JSON
      </span>
    </a>

    <!-- Nav Items -->
    <nav class="flex items-center gap-1 sm:gap-1.5" aria-label="Main Navigation">
      <a href="/" class="text-xs font-medium text-[#171717] hover:text-[#0070f3] px-2.5 py-1.5 rounded-full transition hover:bg-[#f2f2f2]">
        Home
      </a>
      <a href="/#features" class="text-xs font-medium text-[#4d4d4d] hover:text-[#171717] px-2.5 py-1.5 rounded-full transition hover:bg-[#f2f2f2] hidden md:inline-block">
        Features
      </a>
      <a href="/#comparison" class="text-xs font-medium text-[#4d4d4d] hover:text-[#171717] px-2.5 py-1.5 rounded-full transition hover:bg-[#f2f2f2] hidden lg:inline-block">
        YAML vs JSON
      </a>
      <a href="/#faq" class="text-xs font-medium text-[#4d4d4d] hover:text-[#171717] px-2.5 py-1.5 rounded-full transition hover:bg-[#f2f2f2]">
        FAQ
      </a>
      <a href="/about/" class="text-xs font-medium text-[#4d4d4d] hover:text-[#171717] px-2.5 py-1.5 rounded-full transition hover:bg-[#f2f2f2]">
        About
      </a>
      <a href="/contact/" class="text-xs font-medium text-[#4d4d4d] hover:text-[#171717] px-2.5 py-1.5 rounded-full transition hover:bg-[#f2f2f2]">
        Contact
      </a>
    </nav>
  </div>
</header>
