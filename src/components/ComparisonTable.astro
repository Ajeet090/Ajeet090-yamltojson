---
const comparisonData = [
  {
    feature: "Human Readability",
    yaml: "High (indentation-based, minimal punctuation)",
    json: "Moderate (requires quotes, braces, and commas)"
  },
  {
    feature: "Comments Support",
    yaml: "Supported (using # hash symbol)",
    json: "Not supported in standard spec"
  },
  {
    feature: "Data Anchors & Aliases",
    yaml: "Supported (DRY reusable blocks with & and *)",
    json: "Not supported natively"
  },
  {
    feature: "Native Parser Speed",
    yaml: "Fast (requires indentation parser)",
    json: "Ultra-Fast (Native JSON.parse in engine)"
  },
  {
    feature: "Primary Use Cases",
    yaml: "Kubernetes, Docker Compose, Ansible, CI/CD configs",
    json: "REST APIs, Web Services, NoSQL DBs, Config files"
  }
];
---

<section id="comparison" class="py-16 bg-canvas-elevated border-b border-hairline transition-colors duration-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 text-center">
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-mute block mb-2">
        DATA FORMAT CHEATSHEET
      </span>
      <h2 class="text-2xl sm:text-4xl font-semibold tracking-[-0.03em] text-ink mb-3">
        YAML vs JSON Comparison
      </h2>
      <p class="text-base text-body max-w-xl mx-auto">
        Understand key technical differences between YAML (YAML Ain't Markup Language) and JSON (JavaScript Object Notation).
      </p>
    </div>

    <!-- Side-by-Side Syntax Visual Box -->
    <div class="mb-10 bg-canvas rounded-xl border border-hairline p-4 sm:p-6 shadow-2xs">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-hairline">
        <span class="font-mono text-xs font-semibold text-ink uppercase tracking-wider">
          Visual Syntax Comparison
        </span>
        <span class="font-mono text-[11px] text-mute">Equivalent Data Objects</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
        <!-- Left: YAML Block -->
        <div class="bg-canvas-elevated p-4 rounded-lg border border-hairline space-y-2">
          <div class="flex items-center justify-between text-ink border-b border-hairline pb-2 font-semibold text-[11px]">
            <span class="text-[#0070f3]">YAML (.yaml)</span>
            <span class="text-mute font-normal">Indentation & Clean Keys</span>
          </div>
          <pre class="text-ink leading-5 overflow-x-auto"><code><span class="text-mute"># Config Example</span>
<span class="font-semibold text-ink">server:</span>
  <span class="font-semibold text-ink">host:</span> <span class="text-[#0070f3]">"api.domain.com"</span>
  <span class="font-semibold text-ink">port:</span> <span class="text-[#0070f3]">8080</span>
  <span class="font-semibold text-ink">active:</span> <span class="text-[#0070f3]">true</span>
<span class="font-semibold text-ink">roles:</span>
  - <span class="text-[#0070f3]">admin</span>
  - <span class="text-[#0070f3]">developer</span></code></pre>
        </div>

        <!-- Right: JSON Block -->
        <div class="bg-canvas-elevated p-4 rounded-lg border border-hairline space-y-2">
          <div class="flex items-center justify-between text-ink border-b border-hairline pb-2 font-semibold text-[11px]">
            <span class="text-[#0070f3]">JSON (.json)</span>
            <span class="text-mute font-normal">Braces, Quotes & Commas</span>
          </div>
          <pre class="text-ink leading-5 overflow-x-auto"><code>&#123;
  <span class="font-semibold text-ink">"server"</span>: &#123;
    <span class="font-semibold text-ink">"host"</span>: <span class="text-[#0070f3]">"api.domain.com"</span>,
    <span class="font-semibold text-ink">"port"</span>: <span class="text-[#0070f3]">8080</span>,
    <span class="font-semibold text-ink">"active"</span>: <span class="text-[#0070f3]">true</span>
  &#125;,
  <span class="font-semibold text-ink">"roles"</span>: [
    <span class="text-[#0070f3]">"admin"</span>,
    <span class="text-[#0070f3]">"developer"</span>
  ]
&#125;</code></pre>
        </div>
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="overflow-x-auto rounded-xl border border-hairline shadow-2xs">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-canvas border-b border-hairline text-xs font-mono font-semibold text-ink uppercase tracking-wider">
            <th class="py-3.5 px-4 sm:px-6">Feature</th>
            <th class="py-3.5 px-4 sm:px-6">YAML (.yaml / .yml)</th>
            <th class="py-3.5 px-4 sm:px-6">JSON (.json)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-xs sm:text-sm text-body">
          {comparisonData.map((row) => (
            <tr class="hover:bg-canvas/50 transition">
              <td class="py-4 px-4 sm:px-6 font-semibold text-ink font-mono text-xs">
                {row.feature}
              </td>
              <td class="py-4 px-4 sm:px-6">
                {row.yaml}
              </td>
              <td class="py-4 px-4 sm:px-6">
                {row.json}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

  </div>
</section>
