---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms & Conditions - Service Usage Agreement | yamltojson.net"
  description="Read the Terms & Conditions for using yamltojson.net free online YAML to JSON conversion tools."
  canonicalUrl="https://yamltojson.net/terms/"
>
  <Header />

  <main class="flex-1 bg-canvas transition-colors duration-200">
    <!-- Hero Header -->
    <section class="py-12 sm:py-20 mesh-gradient-bg border-b border-hairline">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-mute bg-canvas-elevated border border-hairline px-3 py-1 rounded-full mb-4 shadow-2xs">
          SERVICE AGREEMENT
        </div>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.035em] text-ink mb-4">
          Terms & Conditions
        </h1>
        <p class="text-base sm:text-lg text-body max-w-2xl mx-auto leading-relaxed">
          Please review the terms of service governing your access and use of yamltojson.net.
        </p>
        <p class="text-xs text-mute font-mono mt-3">
          Last Updated: October 3, 2026
        </p>
      </div>
    </section>

    <!-- Main Terms Content -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-canvas-elevated p-6 sm:p-10 rounded-xl border border-hairline shadow-2xs space-y-8 text-sm text-body leading-relaxed">
          
          <!-- Section 1 -->
          <div class="space-y-3">
            <h2 class="text-lg sm:text-xl font-semibold text-ink tracking-tight">
              1. Acceptance of Terms
            </h2>
            <p>
              By accessing or using <strong>yamltojson.net</strong> ("the Service"), you agree to be bound by these Terms & Conditions. If you do not agree with any part of these terms, you must discontinue using the Service.
            </p>
          </div>

          <!-- Section 2 -->
          <div class="space-y-3">
            <h2 class="text-lg sm:text-xl font-semibold text-ink tracking-tight">
              2. Permitted Use & License
            </h2>
            <p>
              yamltojson.net grants you a free, non-exclusive, non-transferable, global license to use our web-based tools for personal, educational, software development, and commercial configuration processing purposes.
            </p>
            <p>You agree not to:</p>
            <ul class="list-disc pl-5 space-y-1.5">
              <li>Attempt to disrupt, overload, or maliciously attack the website infrastructure.</li>
              <li>Use automated scripts to scrape or misrepresent the website.</li>
              <li>Embed or frame the tool on third-party websites without proper attribution.</li>
            </ul>
          </div>

          <!-- Section 3 -->
          <div class="space-y-3">
            <h2 class="text-lg sm:text-xl font-semibold text-ink tracking-tight">
              3. Disclaimer of Warranties
            </h2>
            <p>
              THE SERVICE IS PROVIDED ON AN "AS IS" AND "AS AVAILABLE" BASIS WITHOUT WARRANTIES OF ANY KIND, WHETHER EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, OR NON-INFRINGEMENT.
            </p>
            <p>
              While we strive to ensure 100% accurate conversion according to YAML 1.2 and standard JSON specs, yamltojson.net does not guarantee that conversions will be completely error-free or suitable for critical production deployments without developer review.
            </p>
          </div>

          <!-- Section 4 -->
          <div class="space-y-3">
            <h2 class="text-lg sm:text-xl font-semibold text-ink tracking-tight">
              4. Limitation of Liability
            </h2>
            <p>
              IN NO EVENT SHALL YAMLTOJSON.NET, ITS OPERATORS, OR CONTRIBUTORS BE LIABLE FOR ANY INDIRECT, INCIDENTAL, CONSEQUENTIAL, SPECIAL, OR PUNITIVE DAMAGES (INCLUDING LOSS OF DATA, LOSS OF PROFITS, OR BUSINESS INTERRUPTION) ARISING OUT OF OR IN CONNECTION WITH YOUR USE OR INABILITY TO USE THE SERVICE.
            </p>
          </div>

          <!-- Section 5 -->
          <div class="space-y-3 border-t border-hairline pt-6">
            <h2 class="text-lg sm:text-xl font-semibold text-ink tracking-tight">
              5. Changes to Terms
            </h2>
            <p>
              We reserve the right to update or modify these Terms & Conditions at any time. Any changes will be posted directly on this page with an updated modification date.
            </p>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
