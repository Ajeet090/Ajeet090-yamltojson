---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact Us - Developer Support & Feedback | yamltojson.net"
  description="Get in touch with the yamltojson.net team for support, feature requests, bug reports, or partnership inquiries."
  canonicalUrl="https://yamltojson.net/contact/"
>
  <Header />

  <main class="flex-1 bg-canvas transition-colors duration-200">
    <!-- Hero Header -->
    <section class="py-12 sm:py-20 mesh-gradient-bg border-b border-hairline">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-mute bg-canvas-elevated border border-hairline px-3 py-1 rounded-full mb-4 shadow-2xs">
          GET IN TOUCH
        </div>
        <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.035em] text-ink mb-4">
          Contact Us
        </h1>
        <p class="text-base sm:text-lg text-body max-w-xl mx-auto leading-relaxed">
          Have feedback, feature requests, or bug reports? Send us a message and we'll get back to you promptly.
        </p>
      </div>
    </section>

    <!-- Contact Form & Info Grid -->
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- Contact Info Sidebar -->
          <div class="lg:col-span-1 space-y-6">
            <div class="bg-canvas-elevated p-6 rounded-xl border border-hairline shadow-2xs space-y-4">
              <h2 class="text-base font-semibold text-ink">
                Support & Inquiries
              </h2>
              <p class="text-xs text-body leading-relaxed">
                We value your input! Whether you need help converting complex YAML files or want to request a new feature, our team is here to assist.
              </p>
              
              <div class="pt-4 border-t border-hairline space-y-3 font-mono text-xs">
                <div>
                  <span class="text-mute block">Email:</span>
                  <a href="mailto:support@yamltojson.net" class="text-link font-medium hover:underline">
                    support@yamltojson.net
                  </a>
                </div>
                <div>
                  <span class="text-mute block">Response Time:</span>
                  <span class="text-ink">Within 24-48 Business Hours</span>
                </div>
              </div>
            </div>

            <!-- Privacy Card -->
            <div class="bg-canvas p-5 rounded-xl border border-hairline space-y-2">
              <div class="flex items-center gap-2 text-xs font-semibold text-ink">
                <span class="w-2 h-2 rounded-full bg-link"></span>
                Privacy Commitment
              </div>
              <p class="text-xs text-body leading-relaxed">
                Your contact details are strictly used to respond to your inquiry and are never sold or shared.
              </p>
            </div>
          </div>

          <!-- Contact Form Panel -->
          <div class="lg:col-span-2">
            <div class="bg-canvas-elevated p-6 sm:p-8 rounded-xl border border-hairline shadow-2xs">
              <form id="contact-form" class="space-y-5">
                
                <!-- Success Alert Toast -->
                <div id="contact-success" class="hidden p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium space-y-1">
                  <div class="font-semibold text-sm">Message Sent Successfully!</div>
                  <p>Thank you for reaching out. We have received your inquiry and will reply shortly.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <!-- Name Field -->
                  <div class="space-y-1.5">
                    <label for="contact-name" class="block text-xs font-medium text-ink">
                      Your Name <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="text"
                      id="contact-name"
                      required
                      placeholder="e.g. Alex Johnson"
                      class="w-full px-3.5 py-2.5 rounded-[6px] bg-canvas border border-hairline text-xs text-ink focus:outline-none focus:border-link placeholder:text-faint"
                    />
                  </div>

                  <!-- Email Field -->
                  <div class="space-y-1.5">
                    <label for="contact-email" class="block text-xs font-medium text-ink">
                      Email Address <span class="text-red-500">*</span>
                    </label>
                    <input
                      type="email"
                      id="contact-email"
                      required
                      placeholder="alex@example.com"
                      class="w-full px-3.5 py-2.5 rounded-[6px] bg-canvas border border-hairline text-xs text-ink focus:outline-none focus:border-link placeholder:text-faint"
                    />
                  </div>
                </div>

                <!-- Subject Field -->
                <div class="space-y-1.5">
                  <label for="contact-subject" class="block text-xs font-medium text-ink">
                    Topic / Subject <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="contact-subject"
                    required
                    class="w-full px-3.5 py-2.5 rounded-[6px] bg-canvas border border-hairline text-xs text-ink focus:outline-none focus:border-link cursor-pointer"
                  >
                    <option value="" disabled selected>Select a subject...</option>
                    <option value="feedback">General Feedback</option>
                    <option value="feature">Feature Request</option>
                    <option value="bug">Bug Report</option>
                    <option value="business">Business & Partnership</option>
                  </select>
                </div>

                <!-- Message Field -->
                <div class="space-y-1.5">
                  <label for="contact-message" class="block text-xs font-medium text-ink">
                    Message <span class="text-red-500">*</span>
                  </label>
                  <textarea
                    id="contact-message"
                    rows="5"
                    required
                    placeholder="Write your feedback or questions here..."
                    class="w-full px-3.5 py-2.5 rounded-[6px] bg-canvas border border-hairline text-xs text-ink focus:outline-none focus:border-link placeholder:text-faint resize-y"
                  ></textarea>
                </div>

                <!-- Submit Button -->
                <button
                  type="submit"
                  class="w-full sm:w-auto px-6 py-2.5 rounded-full bg-ink text-canvas text-xs font-semibold hover:opacity-90 transition shadow-xs cursor-pointer"
                >
                  Send Message
                </button>
              </form>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBanner = document.getElementById('contact-success');

  if (form && successBanner) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successBanner.classList.remove('hidden');
      form.reset();
      window.scrollTo({ top: form.offsetTop - 100, behavior: 'smooth' });
    });
  }
</script>
